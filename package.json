{
  "name": "multimedia-drive",
  "version": "1.0.0",
  "description": "Autonomous multimedia streaming platform for Samsung Smart TV UN50NU7400 (Tizen 4.0 / Chromium M56)",
  "private": true,
  "main": "dist/server/index.js",
  "scripts": {
    "build": "tsc",
    "build:client": "vite build --config client/vite.config.ts",
    "build:all": "tsc && vite build --config client/vite.config.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "preview:client": "vite preview --config client/vite.config.ts",
    "start": "node dist/server/index.js",
    "dev": "tsx server/index.ts",
    "test": "node tests/run-e2e.js",
    "test:unit": "tsx --test tests/unit/**/*.test.ts",
    "test:unit:m3": "tsx --test tests/unit/m3/**/*.test.ts",
    "test:unit:dist": "node --test dist/tests/unit/m1/**/*.test.js",
    "test:e2e": "node tests/run-e2e.js",
    "generate:icon": "node tizen/generate-icon.js",
    "build:wgt": "node tizen/build-wgt.js",
    "package:tizen": "npm run build:client && node tizen/generate-icon.js && node tizen/build-wgt.js",
    "test:unit:m4": "tsx --test tests/unit/m4/**/*.test.ts",
    "test:tier1": "node tests/run-e2e.js --tier=1",
    "test:tier2": "node tests/run-e2e.js --tier=2",
    "test:tier3": "node tests/run-e2e.js --tier=3",
    "test:tier4": "node tests/run-e2e.js --tier=4"
  },
  "keywords": [
    "samsung-smart-tv",
    "tizen",
    "chromium-m56",
    "google-drive",
    "http-range-206",
    "webvtt",
    "tmdb",
    "spatial-navigation"
  ],
  "author": "Multimedia Drive Team",
  "license": "UNLICENSED",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "googleapis": "^144.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@vitejs/plugin-legacy": "^8.2.3",
    "terser": "^5.51.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^8.3.4"
  }
}
