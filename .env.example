# ========================================================
# MULTIMEDIA DRIVE - VARIABLES DE ENTORNO
# ========================================================

# 1. ID de la Carpeta de Google Drive (Obligatorio)
# Lo obtienes de la URL de tu carpeta en Google Drive:
# https://drive.google.com/drive/folders/TU_CARPETA_ID_AQUI
DRIVE_ROOT_FOLDER_ID=TU_CARPETA_ID_AQUI

# 2. Clave de TMDB (The Movie Database) (Obligatorio para carátulas de películas)
# Obtén tu clave gratis en: https://www.themoviedb.org/settings/api
TMDB_API_KEY=TU_TMDB_API_KEY_AQUI

# 3. Credenciales de la Cuenta de Servicio de Google (Service Account)
# OPCIÓN A (Recomendada en Local): Coloca tu archivo 'credentials.json' descargado de Google Cloud
# directamente en la raíz de este proyecto (c:\Users\musan\Documents\Proyectos\Multimedia_Drive\credentials.json).
#
# OPCIÓN B (Para Vercel / Nube): Pega el contenido JSON completo de credentials.json en una sola línea aquí:
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# 4. Puerto local (Opcional, por defecto 3000)
PORT=3000
